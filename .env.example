# ============================================================
# MBOX ALERT — configuration
# Copy to .env and fill in. All values are optional except Telegram.
# ============================================================

# ── Chart ────────────────────────────────────────────────────
# TradingView symbol to snapshot (exchange:pair)
SYMBOL=OANDA:XAUUSD
# Candle timeframe in minutes (the Pine script assumes 5m)
TIMEFRAME=5
# Candles drawn on the image
CHART_CANDLES=18
# Canvas size — 1080x1920 is 9:16 portrait (phone friendly)
CHART_WIDTH=1080
CHART_HEIGHT=1920
# Minimum history pulled from TradingView (auto-raised for backfills)
HISTORY_RANGE=120
# Draw the dashed projection of the box out to candle #EXTEND_TO
DRAW_PROJECTION=true

# ── Look & feel ──────────────────────────────────────────────
# light = white background, hollow (white) up candles + solid black down
#         candles, grey 3-decimal price labels — the TradingView light look
# dark  = dark background, teal/red candles
THEME=light
# Price label decimals: 0 = auto (3 for gold-like prices, 5 for FX)
PRICE_DECIMALS=0
SHOW_GRID=true
# Optional per-colour overrides — e.g. teal up candles instead of hollow:
# UP_BODY=#089981
# UP_BORDER=#089981
# DOWN_BODY=#000000
# DOWN_BORDER=#000000
# BOX_COLOR=#ab47bc

# ── MBOX (mirror of the Pine inputs) ─────────────────────────
# Pine: extendTo
EXTEND_TO=10
# Pine: startCandle (candle #1) in IST
BOX_START_IST=17:30
# Daily send time in IST: candle #4 (17:45-17:50) closes at 17:50
SEND_IST=17:50
# Seconds to wait after that close before reading the feed, so candle #4's
# final close tick is included (not a stale mid-candle value)
SETTLE_SEC=6

# ── Schedule ─────────────────────────────────────────────────
DAILY_ENABLED=true
WEEKDAYS_ONLY=true
# Still send if the service wakes up late (minutes after SEND_IST)
SEND_GRACE_MIN=25
# Wait up to this many seconds for candle #4 to close if triggered early
WAIT_FOR_CONFIRM_SEC=420
SCHEDULER_TICK_SEC=20

# ── Telegram ─────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel: @your_channel (bot must be an admin) or numeric -100xxxxxxxxxx
TELEGRAM_CHAT_ID=
# Warn on Telegram if a snapshot could not be built
NOTIFY_ON_FAILURE=true

# ── Hosting / triggers (Render free Web Service) ─────────────
# Self-ping URL used to stay awake around the send window
RENDER_URL=https://your-app.onrender.com/health
# Shared secret for /trigger (recommended in production)
TRIGGER_KEY=change-me
KEEPALIVE_FROM_IST=17:20
KEEPALIVE_TO_IST=18:00
KEEPALIVE_INTERVAL_MIN=10

# ── Local ────────────────────────────────────────────────────
PORT=3000
# Save every rendered PNG to disk
SAVE_PNG=false
# OUTPUT_DIR=./output
